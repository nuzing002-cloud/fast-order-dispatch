PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated allowed origins for HTTP and Socket.IO. "*" is development only.
# NODE_ENV=production requires an explicit origin such as https://orders.example.com
CORS_ORIGIN=*

# Protect HTTP and Socket.IO clients. Leave unset to disable (development only).
# API_KEY=change-me
# Multiple keys with roles and optional per-key quota: token:role[:limit]
# Roles: admin, operator (read/write), viewer (read-only).
# API_KEYS=admin-token:admin:1000,ops-token:operator:300,report-token:viewer
# Production requires at least one key of 16+ characters and rejects placeholders.

# Fixed-window rate limiting per client IP/API key. Set RATE_LIMIT_MAX=0 to disable.
# Production requires a value greater than 0 and a Redis URL for shared counters.
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000

# Trust proxy headers when running behind a reverse proxy.
# TRUST_PROXY=1

# Drivers that may receive orders (comma separated).
# DISPATCH_DRIVER_IDS=1388246780

# PostgreSQL is the production data store and is required when NODE_ENV=production.
# URL-encode special characters in the password (for example @ -> %40).
# DATABASE_URL=postgres://dispatch:dispatch@127.0.0.1:5432/dispatch
# Enable for managed PostgreSQL providers that require TLS. Add a private CA with NODE_EXTRA_CA_CERTS.
# DATABASE_SSL=false
# DATABASE_POOL_MAX=10

# Local development without PostgreSQL: run an embedded PGlite database instead.
# PGlite is single-process only and is rejected in production.
# PGLITE_DATA_DIR=./data/pglite

# Required in production for realtime fan-out between instances and shared rate limits.
# REDIS_URL=redis://127.0.0.1:6379

# Optional: run the dispatcher automatically on an interval (milliseconds, minimum 100).
# AUTO_PROCESS_INTERVAL_MS=1000

# Idempotency keys are retained for this long (default 24 hours).
# IDEMPOTENCY_TTL_MS=86400000

# Percentage of the delivery fee paid to the driver (0-100, default 80).
# DRIVER_SHARE_PERCENT=80

# Web Push (browser notifications). Generate once with `npx web-push generate-vapid-keys`
# and keep the same keys across restarts. Required when NODE_ENV=production.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# Payment provider: mock (default), http, or stripe.
# PAYMENT_PROVIDER=mock
# PAYMENT_GATEWAY_URL=https://payments.example.com/charge
# PAYMENT_GATEWAY_API_KEY=replace-me
# PAYMENT_WEBHOOK_SECRET=replace-me
# STRIPE_SECRET_KEY=sk_test_replace-me
# STRIPE_WEBHOOK_SECRET=whsec_replace-me
# STRIPE_API_BASE=https://api.stripe.com

# Retention used by `npm run db:prune`; audit rows older than this are deleted.
# AUDIT_RETENTION_DAYS=90

# Destructive PostgreSQL integration tests (truncates dispatch tables).
# Only point this at a disposable database.
# TEST_DATABASE_URL=postgres://dispatch:dispatch@127.0.0.1:5432/dispatch

# Docker Compose PostgreSQL service (docker-compose.yml).
# POSTGRES_DB=dispatch
# POSTGRES_USER=dispatch
# POSTGRES_PASSWORD=dispatch
# POSTGRES_PORT=5432
