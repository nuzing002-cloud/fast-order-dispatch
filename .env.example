PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# Protect HTTP and Socket.IO clients. Leave unset to disable (development only).
# API_KEY=change-me

# Fixed-window rate limiting per client IP. Set RATE_LIMIT_MAX=0 to disable.
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000

# Trust proxy headers when running behind a reverse proxy.
# TRUST_PROXY=1

# Drivers that may receive orders (comma separated).
# DISPATCH_DRIVER_IDS=1388246780

# Optional: persist dispatches to a SQLite database (leave unset for in-memory).
# DB_PATH=./data/dispatch.sqlite3

# Optional: fan out realtime events across multiple instances through Redis.
# REDIS_URL=redis://127.0.0.1:6379

# Optional: run the dispatcher automatically on an interval (milliseconds, minimum 100).
# AUTO_PROCESS_INTERVAL_MS=1000
