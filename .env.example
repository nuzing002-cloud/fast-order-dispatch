PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# Optional: persist dispatches to a SQLite database (leave unset for in-memory).
# DB_PATH=./data/dispatch.sqlite3

# Optional: fan out realtime events across multiple instances through Redis.
# REDIS_URL=redis://127.0.0.1:6379

# Optional: run the dispatcher automatically on an interval (milliseconds, minimum 100).
# AUTO_PROCESS_INTERVAL_MS=1000
