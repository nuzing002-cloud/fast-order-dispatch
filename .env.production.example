# Copy to .env.production, replace every value, then run:
# docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

NODE_ENV=production
DOMAIN=orders.example.com
CORS_ORIGIN=https://orders.example.com

# Generate real tokens, e.g. `openssl rand -hex 32`.
# Production startup rejects wildcard CORS, missing auth, mock payments,
# disabled rate limiting, a missing DATABASE_URL/REDIS_URL, and missing
# STRIPE/PAYMENT webhook secrets.
API_KEYS=replace-me
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
DISPATCH_DRIVER_IDS=1388246780

# PostgreSQL. Compose creates the database with POSTGRES_* below; the app connects
# through DATABASE_URL. URL-encode special characters in the password.
POSTGRES_DB=dispatch
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgres://dispatch:replace-with-a-strong-password@postgres:5432/dispatch
# Set DATABASE_SSL=true for managed PostgreSQL; add a private CA with NODE_EXTRA_CA_CERTS.
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Required for realtime fan-out and shared rate limits across instances.
REDIS_URL=redis://redis:6379

PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
# PAYMENT_PROVIDER=http
# PAYMENT_GATEWAY_URL=https://payments.example.com/charge
# PAYMENT_GATEWAY_API_KEY=replace-me
# PAYMENT_WEBHOOK_SECRET=replace-me

# Optional automatic dispatch loop (milliseconds).
AUTO_PROCESS_INTERVAL_MS=1000
